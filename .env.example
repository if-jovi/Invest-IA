# Provedor de IA usado nas recomendacoes: openrouter (padrao), gemini ou claude
IA_PROVEDOR=openrouter

# OpenRouter (https://openrouter.ai/keys) - apenas modelos gratuitos (terminados em ':free')
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Gemini (Google AI Studio) - so e necessario com IA_PROVEDOR=gemini
# GEMINI_API_KEY=sua_chave_aqui
# GEMINI_MODEL=gemini-3.8-flash

# Claude (Anthropic) - so e necessario com IA_PROVEDOR=claude
# ANTHROPIC_API_KEY=sua_chave_aqui
# CLAUDE_MODEL=claude-sonnet-5-5

# Banco de dados
# Rodando LOCAL (sem Docker):
DB_HOST=localhost

# Rodando com DOCKER o docker-compose.yml ja define DB_HOST=db

DB_PORT=5432
DB_NAME=invest_ia
DB_USER=postgres
DB_PASSWORD=postgres
