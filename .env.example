# Provedor de IA usado nas recomendacoes: gemini (padrao) ou claude
IA_PROVEDOR=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui
# GEMINI_MODEL=gemini-3.8-flash

# Claude (Anthropic) - so e necessario com IA_PROVEDOR=claude
# ANTHROPIC_API_KEY=sua_chave_aqui
# CLAUDE_MODEL=claude-sonnet-5-5

# Banco de dados
# Rodando LOCAL (sem Docker):
DB_HOST=localhost

# Rodando com DOCKER o docker-compose.yml ja define DB_HOST=db

DB_PORT=5432
DB_NAME=invest_ia
DB_USER=postgres
DB_PASSWORD=postgres
